{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "mutate": ["src/**/*.ts"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": false,
  "reporters": ["progress", "clear-text", "json", "html"],
  "clearTextReporter": {
    "reportTests": false
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/html/index.html"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental.json",
  "concurrency": 12,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 20,
  "ignorePatterns": [".jj", "docs"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
