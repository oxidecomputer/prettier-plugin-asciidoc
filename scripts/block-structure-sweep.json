      "example": "* a\npara\n[[anc]]\n  lit\n** b\n"
    },
    "+list:unordered; literal=>paragraph": {
      "family": "gap:nested-list-lost",
      "count": 6,
      "example": "* a\npara\n[role]\n  lit\n** b\n"
    },
    "+paragraph; -literal": {
      "family": "gap:lazy-continuation",
      "count": 1,
      "example": "* a\n\n[role]\n  lit\n+\n"
    },
    "-literal": {
      "family": "gap:lazy-continuation",
      "count": 384,
      "example": "* a\n* a\n* a\n[role]\n  lit\n"
    },
    "-literal; literal=>paragraph": {
      "family": "gap:indent-literal-style",
      "count": 1,
      "example": "* a\n[role]\n  lit\n[role]\n  lit\n"
    },
    "-paragraph": {
      "family": "gap:lazy-continuation",
      "count": 477,
      "example": "* a\n** b\n\n+\n\n+\npara\n"
    },
    "literal=>list:unordered": {
      "family": "gap:nested-list-lost",
      "count": 62,
      "example": "* a\n* a\n[role]\n  lit\n** b\n"
    },
    "literal=>paragraph": {
      "family": "gap:indent-literal-style",
      "count": 143,
      "example": "* a\n* a\n+\n[role]\n  lit\n"
    },
    "paragraph=>list:unordered": {
      "family": "gap:nested-list-lost",
      "count": 8,
      "example": "* a\n[role]\n+\n+\n** b\n"
    }
  }
}
